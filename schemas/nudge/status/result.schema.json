{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "command",
    "city_path",
    "agent",
    "session",
    "counts",
    "pending",
    "in_flight",
    "dead"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "ok": {
      "const": true
    },
    "command": {
      "const": "nudge status"
    },
    "city_path": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "session": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "required": [
        "pending",
        "in_flight",
        "dead"
      ],
      "properties": {
        "pending": {
          "type": "integer"
        },
        "in_flight": {
          "type": "integer"
        },
        "dead": {
          "type": "integer"
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "pending": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nudge"
      }
    },
    "in_flight": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nudge"
      }
    },
    "dead": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nudge"
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocked_submission"
      }
    }
  },
  "$defs": {
    "nudge": {
      "type": "object",
      "required": [
        "id",
        "agent",
        "source",
        "message",
        "created_at",
        "deliver_after",
        "expires_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "bead_id": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "continuation_epoch": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "reference": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "deliver_after": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "attempts": {
          "type": "integer"
        },
        "last_attempt_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_error": {
          "type": "string"
        },
        "claimed_at": {
          "type": "string",
          "format": "date-time"
        },
        "lease_until": {
          "type": "string",
          "format": "date-time"
        },
        "dead_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "submission_attempt": {
      "type": "object",
      "required": [
        "id",
        "nudge_ids",
        "session_name",
        "content_sha256",
        "text",
        "started_at",
        "claimed_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "continuation_epoch": {
          "type": "string"
        },
        "session_name": {
          "type": "string"
        },
        "runtime_token": {
          "type": "string"
        },
        "provider_session_id": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "nudge_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "claimed_at": {
          "type": "string",
          "format": "date-time"
        },
        "receipt_capable": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "blocked_submission": {
      "type": "object",
      "required": [
        "nudge_id",
        "state",
        "submission"
      ],
      "properties": {
        "nudge_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "submission_unconfirmed",
            "admitted_awaiting_outcome"
          ]
        },
        "submission": {
          "type": "object",
          "required": [
            "attempt",
            "reason"
          ],
          "properties": {
            "attempt": {
              "$ref": "#/$defs/submission_attempt"
            },
            "reason": {
              "type": "string"
            },
            "admission": {
              "type": "string"
            },
            "turn_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
